programa {
  funcao inicio() {
    // vetores e matrizes= uilizamos para inserir mais de um dado em
    // uma variável, utilizando linhas e tabelas.

    // vetor: Linha.

    // matriz: Tabela.

    //considerando que no mercado a fila de caixa, possui número de
    //pessoas. Cada caixa possui seu número e a fila um número determinado
    //de pessoas.

    //numero de caixas: 1 2 3 4 5

    //pessoas na fila/caixa: 3 0 2 1 7

    // Índice = vetor: 0 1 2 3 4

    inteiro caixas [5] = {3,0,1,2,7}

    inteiro i

  para (i = 0; i < 5; i++){
    escreva("Caixa: ", caixas [i],"\n")
  }

  }
}
